# Generated by scripts/render-config.sh from charts/rproxy-gateway; do not edit.
RPROXY_GATEWAY_LOG_FORMAT=json
RPROXY_GATEWAY_CONTROLLER_NAME=rproxy.max3584.net/gateway-controller
RPROXY_GATEWAY_RESYNC_SECS=30
RPROXY_GATEWAY_LISTEN_ADDR=0.0.0.0
RPROXY_GATEWAY_LEADER_ELECT=true
RPROXY_GATEWAY_CROSS_NAMESPACE_SECRETS=true

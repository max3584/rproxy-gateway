# Generated by scripts/render-config.sh from charts/rproxy-gateway; do not edit.
RPROXY_GATEWAY_LOG_FORMAT=json
RPROXY_GATEWAY_CONTROLLER_NAME=rproxy.max3584.net/gateway-controller
RPROXY_GATEWAY_RESYNC_SECS=30
RPROXY_GATEWAY_LISTEN_ADDR=0.0.0.0
RPROXY_GATEWAY_LEADER_ELECT=true
RPROXY_GATEWAY_CROSS_NAMESPACE_SECRETS=true
RPROXY_GATEWAY_BACKEND_OUTLIER_HTTP=consecutive_5xx=0,consecutive_gateway_failures=3,ejection_time=10s,max_ejected_percent=50,max_ejection_time=1m
RPROXY_GATEWAY_BACKEND_OUTLIER_L4=consecutive_failures=1,ejection_time=10s,max_ejection_time=1m
RPROXY_GATEWAY_BACKEND_CONNECT_TIMEOUT_HTTP=1s
RPROXY_GATEWAY_BACKEND_CONNECT_TIMEOUT_L4=1s
RPROXY_GATEWAY_MODE=fleet
RPROXY_GATEWAY_FLEET_SELECTOR=app.kubernetes.io/name=rproxy,app.kubernetes.io/component=fleet
